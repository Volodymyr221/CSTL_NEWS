# ПРИКЛАД деплою статичного сайту на GitHub Pages.
# Ключова ідея: автоматика НІЧОГО не комітить у бойову гілку — публікує артефактом.
# Стара схема «зібрати → закомітити результат → запушити» ламалась конфліктом
# non-fast-forward, коли бойова гілка рухалась паралельно.
#
# Перейменувати в deploy.yml і покласти в .github/workflows/
# Одноразово: Settings → Pages → Source = "GitHub Actions".

name: Deploy to GitHub Pages

on:
  push:
    branches: [ main ]     # ← бойова гілка
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

# Один деплой одночасно. cancel-in-progress: новіший СКАСОВУЄ старіший у черзі,
# інакше при пачці пушів деплої стакаються і Pages відхиляє застряглі.
concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0        # повна історія — для номера збірки

      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install dependencies
        run: npm install

      - name: Build
        run: node build.js

      - name: Update deploy version stamp
        # Індикатор для власника: якщо після пушу число не змінилось — деплой не пройшов.
        run: |
          DEPLOY_TIME=$(TZ='Europe/Kyiv' date '+%d.%m %H:%M')
          BUILD_NUM=$(git rev-list --count --no-merges HEAD)
          sed -i "s|v[0-9]\+ · [0-9][0-9]\.[0-9][0-9] [0-9][0-9]:[0-9][0-9]|v${BUILD_NUM} · ${DEPLOY_TIME}|" index.html

      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: .

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
